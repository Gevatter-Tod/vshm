<?xml version="1.0" encoding="utf-8"?>
<!-- Sample valid WebDAV 207 multistatus body (depth 1 listing) for tests and
     for the fake PROPFIND endpoint used in wp08 runtime validation. -->
<D:multistatus xmlns:D="DAV:">
  <D:response>
    <D:href>/dav/</D:href>
    <D:propstat>
      <D:prop><D:displayname>dav</D:displayname><D:resourcetype><D:collection/></D:resourcetype></D:prop>
      <D:status>HTTP/1.1 200 OK</D:status>
    </D:propstat>
  </D:response>
  <D:response>
    <D:href>/dav/readme.txt</D:href>
    <D:propstat>
      <D:prop><D:displayname>readme.txt</D:displayname><D:getcontentlength>42</D:getcontentlength></D:prop>
      <D:status>HTTP/1.1 200 OK</D:status>
    </D:propstat>
  </D:response>
</D:multistatus>
